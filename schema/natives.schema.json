{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xcounting/FAR/schema/natives.schema.json",
  "title": "FAR native asset table",
  "type": "object",
  "required": ["natives"],
  "properties": {
    "natives": {
      "type": "object",
      "description": "CoinGecko coin id -> the chain-scoped CAIP-19 identities of that coin as a unit of account. A coin appears on several chains when the same native is the gas token of each (ETH on every L2).",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["caip2", "caip19", "confidence", "evidence"],
          "properties": {
            "caip2": { "type": "string" },
            "caip19": { "type": "string", "pattern": "/slip44:[0-9]+$" },
            "chainName": { "type": ["string", "null"] },
            "confidence": { "enum": ["high", "medium", "low"] },
            "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
