{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xcounting/FAR/schema/links.schema.json",
  "title": "FAR curated DTI links",
  "type": "object",
  "required": ["accepted", "rejected"],
  "properties": {
    "accepted": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "rejected": { "type": "array", "items": { "$ref": "#/$defs/link" } }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["dti", "coingeckoId", "rationale", "decidedIn"],
      "properties": {
        "dti": { "type": "string", "pattern": "^[0-9A-Z]{9}$" },
        "coingeckoId": { "type": "string" },
        "rationale": {
          "description": "What was checked. Not how confident the reviewer is.",
          "type": "string", "minLength": 20
        },
        "decidedIn": {
          "description": "URL of the issue or PR where this was argued and decided.",
          "type": "string"
        }
      }
    }
  }
}
