{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xcounting/far/schema/ledgers.schema.json",
  "title": "FAR DTI ledger table",
  "description": "DTI ledger records (DLIs) mapped to CAIP-2 — DTIF's own chain vocabulary in CAIP terms. Does NOT say which ledger a given token record sits on; the snapshot redacts that.",
  "type": "object",
  "required": ["ledgers"],
  "properties": {
    "ledgers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["caip2", "kind", "confidence", "evidence"],
        "properties": {
          "caip2": {
            "description": "null for permissioned ledgers, which have no public chain identifier and never will.",
            "type": ["string", "null"]
          },
          "longName": { "type": ["string", "null"] },
          "kind": { "enum": ["public", "permissioned", "unknown"] },
          "confidence": { "enum": ["high", "medium", "low", "proposed"] },
          "assertedBy": { "type": ["string", "null"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "note": { "type": ["string", "null"] },
          "uncertainty": { "type": ["string", "null"] }
        }
      }
    }
  }
}
